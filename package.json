{
  "name": "sonicguardian-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "node ./node_modules/@typescript/native/bin/tsc --noEmit",
    "test:unit": "node --test scripts/test-shamir.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "CI=true pnpm build && playwright test --project=chromium",
    "mcp:build": "pnpm --dir packages/mcp-server build",
    "mcp:dev": "pnpm --dir packages/mcp-server build && node packages/mcp-server/dist/index.js stdio",
    "prepare": "husky",
    "contracts:build": "cd contracts && scarb build",
    "contracts:deploy": "node contracts/scripts/deploy.js",
    "contracts:deploy:sh": "cd contracts && ./scripts/deploy.sh",
    "contracts:setup": "cd contracts && ./scripts/setup-account.sh"
  },
  "dependencies": {
    "@sats-connect/core": "0.17.1",
    "@starknet-io/get-starknet": "4.0.8",
    "@starknet-io/get-starknet-discovery": "6.0.2",
    "@starknet-io/get-starknet-wallet-standard": "6.0.2",
    "@starknet-io/types-js": "0.10.3",
    "@starknet-react/chains": "5.0.3",
    "@starknet-react/core": "5.0.3",
    "@strudel/core": "1.2.6",
    "@strudel/mini": "1.2.6",
    "@strudel/tonal": "1.2.6",
    "@strudel/transpiler": "1.2.6",
    "@strudel/web": "1.2.6",
    "@strudel/webaudio": "1.2.6",
    "@web3auth/base": "9.7.0",
    "@web3auth/modal": "10.15.0",
    "acorn": "^8.11.3",
    "clsx": "^2.1.0",
    "estree-walker": "^3.0.3",
    "ethers": "6.16.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sats-connect": "4.2.1",
    "starknet": "10.4.0",
    "starkzap": "1.0.0",
    "tailwind-merge": "^2.2.1",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@next/playwright": "16.3.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.160.0",
    "@types/webcrypto": "0.0.30",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.2",
    "husky": "9.1.7",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "6.0.2"
  }
}
