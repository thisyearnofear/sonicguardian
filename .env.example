# AI API Keys
VENICE_API_KEY=your_venice_api_key_here

# AI Configuration
NEXT_PUBLIC_USE_REAL_AI=true
NEXT_PUBLIC_AI_PROVIDER=venice
NEXT_PUBLIC_APP_URL=https://sonicguardian.vercel.app

# Network & Wallet
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Web3Auth (Social Login)
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=

# Starknet RPC (STRK20 + commits)
NEXT_PUBLIC_STARKNET_MAINNET_RPC=https://rpc.starknet.lava.build
NEXT_PUBLIC_STARKNET_SEPOLIA_RPC=https://starknet-sepolia.public.blastapi.io/rpc/v0_7

# STRK20 mainnet pool (verified)
# POOL=0x040337b1af3c663e86e333bab5a4b28da8d4652a15a69beee2b677776ffe812a

# Recovery anonymizer (deploy RecoveryInvokeHelper — see docs/HACKATHON.md)
NEXT_PUBLIC_RECOVERY_HELPER_MAINNET=
# Optional: track Sepolia helper after Phase 1 deploy
# NEXT_PUBLIC_RECOVERY_HELPER_SEPOLIA=0x04159e043db4260022b55e6390fc7778e58bfa3f4be36d56b0f0310f04ab0e32

# Starknet Contract Deployment
NEXT_PUBLIC_SONIC_GUARDIAN_ADDRESS=

# Starknet deployer account (sncast/starkli — see contracts/DEPLOYMENT_STATUS.md)
STARKNET_ACCOUNT_ADDRESS=
STARKNET_ACCOUNT=~/.starkli-wallets/sonicguardian/account.json
STARKNET_ACCOUNT_CONFIG=~/.starkli-wallets/sonicguardian/account.json
STARKNET_ACCOUNT_PRIVATE_KEY=~/.starkli-wallets/sonicguardian/keystore.json
STARKNET_KEYSTORE=~/.starkli-wallets/sonicguardian/keystore.json
STARKNET_KEYSTORE_PASSWORD=
STARKNET_PRIVATE_KEY=
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io/rpc/v0_7

# Starkzap API
NEXT_PUBLIC_STARKZAP_API_KEY=
